# OnePlus 9 24B119 offline RAM boot package before the A660 overlay.
# prepare-a660-ramboot.py enables gpu and metal when supplied a signed bundle.
cpus=4
cpufreq=1
ddr=0
gpu=0
metal=0
metal_procs=SpringBoard
metal_trace=1
gpu_log=2
wifi=0
bt=0
adsp=0
sound=0
cam=0
haptic=0
sensors=0
thermal=0
backlight=1
touchscreen=1
touch_lat=1
buttons=1
battery=1
ufs=0
ufs_native=0
ufs_write=0
var_store=0
launchd_unsecure_cache=1
apfs_volume=md0,v=1
apfs_volume_at=/private/preboot
